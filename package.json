{
  "name": "nexo-eventos", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1", "build": "tsc --noEmit && vite build", "preview": "vite preview --host 127.0.0.1",
    "dev:full": "npm run build && wrangler pages dev dist --port 8788", "db:migrate": "wrangler d1 migrations apply nexo-eventos --local",
    "db:migrate:remote": "wrangler d1 migrations apply nexo-eventos --remote", "admin:create": "node scripts/create-admin.mjs",
    "test": "vitest run", "test:integration": "node scripts/integration.mjs", "deploy": "npm run build && wrangler pages deploy dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@pdf-lib/fontkit": "^1.1.1", "@fontsource/nunito": "^5.2.0", "@zxing/browser": "^0.1.5", "lucide-react": "^0.468.0", "pdf-lib": "^1.17.1", "qrcode": "^1.5.4", "react": "^19.0.0", "react-dom": "^19.0.0", "react-router-dom": "^7.0.0", "zod": "^3.24.0" },
  "devDependencies": { "@cloudflare/workers-types": "^5.20261015.1", "@types/node": "^24.0.0", "@types/qrcode": "^1.5.5", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "^5.9.0", "vite": "^7.0.0", "vitest": "^3.2.0", "wrangler": "^4.0.0", "miniflare": "^4.0.0" }
}
